// Prisma schema for Resulta - School Result Management Platform
// Multi-tenant architecture connecting to PostgreSQL on Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  platform_admin
  school_admin
  teacher
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  GRADUATED
  LEFT
}

enum TermStatus {
  DRAFT
  PUBLISHED
}

enum ResultStatus {
  DRAFT
  SUBMITTED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PinStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum ComplaintStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ShareLedgerEntryType {
  SHARE_DUE
  REVERSAL
  SETTLEMENT
}

model School {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  logo_url               String?
  card_price             Decimal         @default(2000.00) @db.Decimal(10, 2)
  platform_share         Decimal         @default(1000.00) @db.Decimal(10, 2)
  roster_confirmed_at    DateTime?
  roster_confirmed_count Int?
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt

  users               User[]
  classes             Class[]
  subjects            Subject[]
  teacherAssignments TeacherAssignment[]
  students            Student[]
  studentImports      StudentImport[]
  terms               Term[]
  results             Result[]
  studentTermStatuses StudentTermStatus[]
  paymentBatches      PaymentBatch[]
  pins                Pin[]
  gradingSchemes      GradingScheme[]
  auditLogs           AuditLog[]
  complaints          Complaint[]
  shareLedgerEntries  ShareLedgerEntry[]

  @@index([slug])
}

model User {
  id                   String   @id @default(uuid())
  email                String?  @unique
  phone                String?  @unique
  name                 String
  password_hash        String
  role                 Role
  school_id            String?
  must_change_password Boolean  @default(false)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  school             School?             @relation(fields: [school_id], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  confirmedBatches   PaymentBatch[]      @relation("BatchConfirmer")
  studentImports     StudentImport[]
  auditLogs          AuditLog[]
  markedLedgerEntries ShareLedgerEntry[] @relation("LedgerMarker")

  @@index([school_id])
  @@index([email])
  @@index([phone])
}

model Class {
  id         String   @id @default(uuid())
  school_id  String
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  school             School              @relation(fields: [school_id], references: [id], onDelete: Cascade)
  students           Student[]
  teacherAssignments TeacherAssignment[]

  @@unique([school_id, name])
  @@index([school_id])
}

model Subject {
  id         String   @id @default(uuid())
  school_id  String
  name       String
  code       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  school             School              @relation(fields: [school_id], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  results            Result[]

  @@unique([school_id, name])
  @@index([school_id])
}

model TeacherAssignment {
  id         String   @id @default(uuid())
  school_id  String
  teacher_id String
  class_id   String
  subject_id String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  school  School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  teacher User    @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([school_id, teacher_id, class_id, subject_id])
  @@index([school_id])
  @@index([teacher_id])
  @@index([class_id])
  @@index([subject_id])
}

model Student {
  id               String        @id @default(uuid())
  school_id        String
  admission_number String
  full_name        String
  class_id         String
  status                 StudentStatus @default(ACTIVE)
  not_in_latest_upload   Boolean       @default(false)
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt

  school       School              @relation(fields: [school_id], references: [id], onDelete: Cascade)
  class        Class               @relation(fields: [class_id], references: [id], onDelete: Restrict)
  results      Result[]
  termStatuses StudentTermStatus[]
  pins         Pin[]
  complaints   Complaint[]
  shareLedgerEntries ShareLedgerEntry[]

  @@unique([school_id, admission_number])
  @@index([school_id])
  @@index([class_id])
  @@index([admission_number])
  @@index([school_id, class_id])
  @@index([school_id, status])
}

model StudentImport {
  id                   String   @id @default(uuid())
  school_id            String
  user_id              String?
  file_name            String
  new_count            Int
  updated_count        Int
  unchanged_count      Int
  error_count          Int
  total_count          Int
  active_student_count Int?
  expected_total       Decimal? @db.Decimal(12, 2)
  expected_share       Decimal? @db.Decimal(12, 2)
  created_at           DateTime @default(now())

  school School @relation(fields: [school_id], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([school_id])
}

model Term {
  id          String     @id @default(uuid())
  school_id   String
  session     String     // e.g. "2026/2027"
  term_number Int        // 1, 2, or 3
  start_date  DateTime?
  end_date    DateTime?
  status      TermStatus @default(DRAFT)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  school         School              @relation(fields: [school_id], references: [id], onDelete: Cascade)
  results        Result[]
  termStatuses   StudentTermStatus[]
  paymentBatches PaymentBatch[]
  pins           Pin[]
  complaints     Complaint[]
  shareLedgerEntries ShareLedgerEntry[]

  @@unique([school_id, session, term_number])
  @@index([school_id])
  @@index([session])
  @@index([status])
  @@index([school_id, status])
}

model Result {
  id         String       @id @default(uuid())
  school_id  String
  student_id String
  term_id    String
  subject_id String
  ca_score   Decimal?     @db.Decimal(5, 2)
  exam_score Decimal?     @db.Decimal(5, 2)
  total      Decimal?     @db.Decimal(5, 2)
  grade      String?
  remark     String?
  status     ResultStatus @default(DRAFT)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  school  School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [term_id], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([student_id, term_id, subject_id])
  @@index([school_id])
  @@index([student_id])
  @@index([term_id])
  @@index([subject_id])
  @@index([status])
  @@index([school_id, term_id, status])
  @@index([student_id, term_id, status])
  @@index([school_id, subject_id, term_id])
}

model StudentTermStatus {
  id            String   @id @default(uuid())
  school_id     String
  student_id    String
  term_id       String
  fees_paid     Boolean  @default(false)
  result_locked Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  school  School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [term_id], references: [id], onDelete: Cascade)

  @@unique([student_id, term_id])
  @@index([school_id])
  @@index([student_id])
  @@index([term_id])
  @@index([school_id, term_id, fees_paid])
  @@index([student_id, term_id, result_locked])
}

model PaymentBatch {
  id              String        @id @default(uuid())
  school_id       String
  term_id         String
  students_count  Int
  amount_due      Decimal       @db.Decimal(12, 2)
  amount_received Decimal       @default(0.00) @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)
  confirmed_by    String?
  confirmed_at    DateTime?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  school    School @relation(fields: [school_id], references: [id], onDelete: Cascade)
  term      Term   @relation(fields: [term_id], references: [id], onDelete: Cascade)
  confirmer User?  @relation("BatchConfirmer", fields: [confirmed_by], references: [id], onDelete: SetNull)

  @@index([school_id])
  @@index([term_id])
  @@index([status])
  @@index([school_id, term_id, status])
}

model Pin {
  id           String    @id @default(uuid())
  school_id    String
  student_id   String
  term_id      String
  pin_hash     String
  logins_used  Int       @default(0)
  max_logins   Int       @default(5)
  status       PinStatus @default(ACTIVE)
  generated_at DateTime  @default(now())
  expires_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  school  School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [term_id], references: [id], onDelete: Cascade)

  @@index([school_id])
  @@index([student_id, term_id])
  @@index([pin_hash])
  @@index([status])
  @@index([school_id, student_id])
  @@index([school_id, term_id])
  @@index([student_id, status])
}

model AuditLog {
  id         String   @id @default(uuid())
  school_id  String?
  user_id    String?
  action     String
  entity     String
  entity_id  String?
  old_values Json?
  new_values Json?
  reason     String?
  timestamp  DateTime @default(now())

  school School? @relation(fields: [school_id], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([school_id])
  @@index([user_id])
  @@index([action])
  @@index([timestamp])
}

model Complaint {
  id         String          @id @default(uuid())
  school_id  String
  student_id String
  term_id    String
  message    String          @db.Text
  status     ComplaintStatus @default(PENDING)
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt

  school  School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [term_id], references: [id], onDelete: Cascade)

  @@index([school_id])
  @@index([student_id])
  @@index([term_id])
  @@index([status])
  @@index([school_id, status])
}

model GradingScheme {
  id          String   @id @default(uuid())
  school_id   String
  class_level String?   // optional, e.g., "Form 1"
  name        String   // scheme name, e.g., "Default"
  parts       Json     // [{ name: string, max: number }]
  boundaries  Json     // [{ grade: string, min: number, max: number, remark: string }]
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  school School @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@index([school_id])
  @@index([school_id, class_level])
}

// Append-only ledger for platform share tracking.
// Never edited or deleted after creation.
model ShareLedgerEntry {
  id                String               @id @default(uuid())
  school_id         String
  student_id        String?              // null for SETTLEMENT entries
  term_id           String?              // optional; null allowed for school-level settlements
  type              ShareLedgerEntryType
  amount            Decimal              @db.Decimal(12, 2)
  marked_by_user_id String?
  reference         String?
  note              String?              @db.Text
  created_at        DateTime             @default(now())

  school      School   @relation(fields: [school_id], references: [id], onDelete: Restrict)
  student     Student? @relation(fields: [student_id], references: [id], onDelete: Restrict)
  term        Term?    @relation(fields: [term_id], references: [id], onDelete: Restrict)
  marked_by   User?    @relation("LedgerMarker", fields: [marked_by_user_id], references: [id], onDelete: SetNull)

  @@index([school_id, created_at])
  @@index([term_id])
  @@index([school_id, type])
  @@index([student_id, term_id])
}
