# ==========================================
# Platform Identity Configuration
# Configurable dynamically: do not hard-code
# ==========================================
PLATFORM_NAME="Resulta"
PLATFORM_DOMAIN="localhost"
NEXT_PUBLIC_PLATFORM_NAME="Resulta"
NEXT_PUBLIC_PLATFORM_DOMAIN="localhost"
PORT=3000

# ==========================================
# Supabase Configuration
# Dashboard -> Settings -> API
# ==========================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ==========================================
# Prisma & PostgreSQL on Supabase
# ==========================================
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ==========================================
# Security Keys
# Keyed hash secret for PINs (BRIEF.md rule 5)
# ==========================================
PIN_HMAC_SECRET="replace-with-a-secure-random-32-byte-hex-secret"
